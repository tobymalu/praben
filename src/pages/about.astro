---
import Layout from "../layouts/Layout.astro";
import FinalCTA from "../components/FinalCTA.astro";

const commitments = [
  {
    title: "One Contract, No Fine Print",
    body: "A single, straightforward agreement covering marketing, maintenance, and hosting — no separate vendors, no hidden fees, no convoluted commission tiers.",
  },
  {
    title: "Reporting You Don't Have to Chase",
    body: "Automated, transparent performance and occupancy reports, delivered on a schedule — not withheld until you ask.",
  },
  {
    title: "Boutique Attention, Not a Catalog Number",
    body: "A dedicated point of contact who knows your property, backed by direct business lines — not a support queue.",
  },
];
---

<Layout
  title="About Us | Praben Property Management"
  description="Praben is a boutique, B2B property management partner in Puerto Vallarta built around transparency — the opposite of a fragmented, commission-heavy traditional agency."
>
  <main>
    <section class="bg-primary px-4 py-16 text-center sm:px-6 sm:py-24">
      <div class="mx-auto max-w-2xl">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-accent">
          About Praben
        </p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
          A Different Model, Built for Remote Owners.
        </h1>
        <p class="mt-4 font-light text-white/85">
          Traditional Puerto Vallarta property management runs on
          fragmented services and opaque fees. We built Praben as the
          alternative: one accountable partner, transparent by default.
        </p>
      </div>
    </section>

    <section class="px-4 py-16 sm:px-6 sm:py-24">
      <div class="mx-auto max-w-6xl">
        <h2 class="mx-auto max-w-2xl text-center text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
          What Sets Praben Apart
        </h2>
        <div class="mt-12 grid gap-8 md:grid-cols-3">
          {commitments.map((item) => (
            <div class="border-l-2 border-primary pl-4">
              <h3 class="font-medium text-foreground">{item.title}</h3>
              <p class="mt-1 font-light text-muted-foreground">{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <FinalCTA />
  </main>
</Layout>

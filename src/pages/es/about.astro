---
import Layout from "../../layouts/Layout.astro";
import FinalCTA from "../../components/FinalCTA.astro";

const commitments = [
  {
    title: "Un Solo Contrato, Sin Letra Pequeña",
    body: "Un acuerdo único y claro que cubre marketing, mantenimiento y hospedaje — sin proveedores separados, sin tarifas ocultas, sin niveles de comisión confusos.",
  },
  {
    title: "Reportes que No Tienes que Perseguir",
    body: "Reportes automatizados y transparentes de desempeño y ocupación, entregados en un calendario fijo — no retenidos hasta que los pidas.",
  },
  {
    title: "Atención Boutique, No un Número de Catálogo",
    body: "Un punto de contacto dedicado que conoce tu propiedad, respaldado por líneas directas de negocio — no una fila de soporte.",
  },
];
---

<Layout
  title="Nosotros | Praben Property Management"
  description="Praben es un socio boutique de administración de propiedades B2B en Puerto Vallarta, construido alrededor de la transparencia — lo opuesto a una agencia tradicional fragmentada y cargada de comisiones."
  lang="es"
>
  <main>
    <section class="bg-primary px-4 py-16 text-center sm:px-6 sm:py-24">
      <div class="mx-auto max-w-2xl">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-accent">
          Sobre Praben
        </p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
          Un Modelo Diferente, Hecho para Propietarios a Distancia.
        </h1>
        <p class="mt-4 font-light text-white/85">
          La administración de propiedades tradicional en Puerto Vallarta
          funciona con servicios fragmentados y tarifas poco claras. Creamos
          Praben como la alternativa: un solo socio responsable, transparente
          por diseño.
        </p>
      </div>
    </section>

    <section class="px-4 py-16 sm:px-6 sm:py-24">
      <div class="mx-auto max-w-6xl">
        <h2 class="mx-auto max-w-2xl text-center text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
          Qué Distingue a Praben
        </h2>
        <div class="mt-12 grid gap-8 md:grid-cols-3">
          {commitments.map((item) => (
            <div class="border-l-2 border-primary pl-4">
              <h3 class="font-medium text-foreground">{item.title}</h3>
              <p class="mt-1 font-light text-muted-foreground">{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <FinalCTA lang="es" />
  </main>
</Layout>

---
import Layout from "../../layouts/Layout.astro";
import { SITE, whatsappUrl } from "../../lib/site";

type Entry = { name: string; note?: string; numbers: string[] };
type Category = { title: string; entries: Entry[] };

const toTel = (n: string) => n.replace(/[^\d+]/g, "");

const categories: Category[] = [
  {
    title: "Emergencias y Primeros Auxilios",
    entries: [
      { name: "Emergencia General (Policía, Bomberos, Ambulancia)", numbers: ["911", "+52 322 225 0000"] },
      { name: "Ambulancia Cruz Roja", numbers: ["+52 322 222 1533"] },
      { name: "Departamento de Bomberos", numbers: ["+52 322 222 1500"] },
      { name: "Policía Turística", numbers: ["+52 322 224 0123"] },
    ],
  },
  {
    title: "Hospitales y Centros Médicos",
    entries: [
      { name: "Hospital Joya Marina", note: "Antes Hospiten", numbers: ["+52 322 226 1010"] },
      { name: "CMQ City Center", note: "Centro", numbers: ["+52 322 223 1919"] },
      { name: "CMQ Premiere", note: "Av. Prisciliano Sánchez", numbers: ["+52 322 226 6500"] },
      { name: "Vallarta Medical Center", numbers: ["+52 322 178 8000"] },
    ],
  },
  {
    title: "Consulados y Asistencia a Extranjeros",
    entries: [
      { name: "Agencia Consular de EE. UU.", note: "Puerto Vallarta", numbers: ["+52 33 3268 2100", "+52 55 8526 2561"] },
      { name: "Agencia Consular de Canadá", note: "Puerto Vallarta", numbers: ["+52 322 225 3780", "+52 800 706 2900"] },
    ],
  },
  {
    title: "Servicios Públicos e Infraestructura",
    entries: [
      { name: "CFE (Emergencias Eléctricas)", numbers: ["071"] },
      { name: "SEAPAL (Agua y Drenaje)", numbers: ["+52 322 226 9191"] },
      { name: "Aeropuerto Internacional de Puerto Vallarta (PVR)", numbers: ["+52 322 221 1298"] },
    ],
  },
];
---

<Layout
  title="Números de Emergencia e Importantes en Puerto Vallarta | Praben"
  description="Números esenciales de emergencia, hospitales, consulados y servicios públicos para propietarios, huéspedes y residentes en Puerto Vallarta."
  lang="es"
>
  <main>
    <section class="bg-primary px-4 py-16 text-center sm:px-6 sm:py-20">
      <div class="mx-auto max-w-3xl">
        <h1 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">
          Directorio de Emergencias y Contactos Importantes de Puerto Vallarta
        </h1>
        <p class="mt-4 font-light text-white/85">
          Números de contacto esenciales para propietarios, huéspedes y
          residentes en Puerto Vallarta. Guarda esta página en tus favoritos
          para asistencia inmediata.
        </p>

        <div class="mt-8 rounded-2xl bg-white p-6 text-left shadow-xl sm:flex sm:items-center sm:justify-between sm:gap-6">
          <div>
            <p class="text-xs font-medium uppercase tracking-[0.2em] text-secondary">
              Servicios de Emergencia
            </p>
            <p class="mt-1 text-lg font-semibold text-foreground">
              ¿Estás en peligro inmediato? Llama al 911.
            </p>
          </div>
          <a
            href="tel:911"
            class="mt-4 block rounded-lg bg-accent px-8 py-4 text-center text-2xl font-semibold text-foreground transition hover:opacity-90 sm:mt-0"
          >
            Llamar al 911
          </a>
        </div>
      </div>
    </section>

    <section class="bg-muted px-4 py-16 sm:px-6 sm:py-20">
      <div class="mx-auto grid max-w-6xl gap-8 md:grid-cols-2">
        {categories.map((category) => (
          <div class="rounded-2xl bg-white p-6 shadow-sm sm:p-8">
            <h2 class="border-b-2 border-secondary/20 pb-3 text-xl font-semibold text-primary">
              {category.title}
            </h2>
            <ul class="mt-4 divide-y divide-brand-gray-50">
              {category.entries.map((entry) => (
                <li class="py-4">
                  <p class="font-medium text-foreground">{entry.name}</p>
                  {entry.note && (
                    <p class="text-sm font-extralight text-muted-foreground">{entry.note}</p>
                  )}
                  <div class="mt-2 flex flex-wrap gap-2">
                    {entry.numbers.map((number) => (
                      <a
                        href={`tel:${toTel(number)}`}
                        class="inline-flex items-center rounded-lg bg-primary px-4 py-2 text-sm font-medium text-white transition hover:opacity-90"
                      >
                        {number}
                      </a>
                    ))}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-secondary px-4 py-14 text-center sm:px-6 sm:py-16">
      <div class="mx-auto max-w-2xl">
        <h2 class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">
          ¿Eres propietario o huésped de una propiedad Praben?
        </h2>
        <p class="mt-3 font-light text-white/85">
          Contacta directamente nuestra línea de soporte 24/7.
        </p>
        <a
          href={whatsappUrl("Hola Praben, necesito asistencia.")}
          target="_blank"
          rel="noopener"
          class="mt-6 inline-block rounded-lg bg-accent px-8 py-4 text-base font-medium text-foreground transition hover:opacity-90"
        >
          WhatsApp {SITE.phone.display}
        </a>
      </div>
    </section>
  </main>
</Layout>

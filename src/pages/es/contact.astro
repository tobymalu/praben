---
import Layout from "../../layouts/Layout.astro";
import { SITE, whatsappUrl } from "../../lib/site";
---

<Layout
  title="Contacto | Praben Property Management"
  description="Ponte en contacto con Praben Property Management — correo, WhatsApp y líneas telefónicas directas para propietarios en Puerto Vallarta."
  lang="es"
>
  <main>
    <section class="bg-primary px-4 py-16 text-center sm:px-6 sm:py-24">
      <div class="mx-auto max-w-2xl">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-accent">
          Contacto
        </p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
          Habla Directo con Praben.
        </h1>
        <p class="mt-4 font-light text-white/85">
          Sin filas de soporte, sin número de ticket. Contacta a nuestro
          equipo por el canal que prefieras.
        </p>
      </div>
    </section>

    <section class="px-4 py-16 sm:px-6 sm:py-24">
      <div class="mx-auto grid max-w-4xl gap-6 sm:grid-cols-3">
        <a
          href={`mailto:${SITE.email}`}
          class="rounded-2xl bg-muted p-6 text-center transition hover:shadow-md"
        >
          <h2 class="font-medium text-foreground">Correo</h2>
          <p class="mt-2 font-light text-muted-foreground">{SITE.email}</p>
        </a>
        <a
          href={`tel:${SITE.phone.e164}`}
          class="rounded-2xl bg-muted p-6 text-center transition hover:shadow-md"
        >
          <h2 class="font-medium text-foreground">Teléfono</h2>
          <p class="mt-2 font-light text-muted-foreground">{SITE.phone.display}</p>
        </a>
        <a
          href={whatsappUrl(undefined, "es")}
          target="_blank"
          rel="noopener"
          class="rounded-2xl bg-muted p-6 text-center transition hover:shadow-md"
        >
          <h2 class="font-medium text-foreground">WhatsApp</h2>
          <p class="mt-2 font-light text-muted-foreground">{SITE.phone.display}</p>
        </a>
      </div>

      <!-- TODO: replace with a real embedded map once there's a confirmed office address. -->
      <div class="mx-auto mt-10 flex h-64 max-w-4xl items-center justify-center rounded-2xl bg-muted text-sm font-light text-muted-foreground">
        Ubicación de oficina próximamente.
      </div>
    </section>
  </main>
</Layout>

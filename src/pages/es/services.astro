---
import Layout from "../../layouts/Layout.astro";
import AuthorityBlock from "../../components/AuthorityBlock.astro";
import FinalCTA from "../../components/FinalCTA.astro";

const pillars = [
  {
    title: "Marketing Dinámico de Ingresos",
    body: "Gestión profesional de anuncios y precios basados en datos en todas las principales plataformas de reserva, ajustados semanalmente a la demanda real de Puerto Vallarta — no un calendario fijo en piloto automático.",
  },
  {
    title: "Mantenimiento Impecable",
    body: "Inspecciones preventivas, contratistas verificados y respuesta rápida ante reparaciones, para que tu propiedad esté lista para huéspedes todo el año sin que tengas que atender una sola llamada.",
  },
  {
    title: "Concierge de Huéspedes de Lujo",
    body: "Check-ins de alto nivel, recomendaciones locales curadas y soporte 24/7 que protegen tus reseñas y convierten a huéspedes primerizos en clientes recurrentes.",
  },
];
---

<Layout
  title="Servicios | Praben Property Management"
  description="Un servicio único de administración todo en uno para inversionistas en Puerto Vallarta — marketing, mantenimiento y concierge de huéspedes, sin contratos fragmentados."
  lang="es"
>
  <main>
    <section class="bg-primary px-4 py-16 text-center sm:px-6 sm:py-24">
      <div class="mx-auto max-w-2xl">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-accent">
          Nuestros Servicios
        </p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
          Un Solo Socio. Cada Disciplina que tu Propiedad Necesita.
        </h1>
        <p class="mt-4 font-light text-white/85">
          Sin señalamientos entre una agencia de marketing, una cuadrilla de
          mantenimiento y una plataforma de hospedaje. Praben opera los tres
          bajo un mismo techo, con una sola responsabilidad.
        </p>
      </div>
    </section>

    <section class="px-4 py-16 sm:px-6 sm:py-24">
      <div class="mx-auto grid max-w-6xl gap-8 md:grid-cols-3">
        {pillars.map((pillar) => (
          <div class="rounded-2xl bg-muted p-8">
            <h2 class="text-lg font-semibold text-primary">{pillar.title}</h2>
            <p class="mt-3 font-light text-muted-foreground">{pillar.body}</p>
          </div>
        ))}
      </div>
    </section>

    <AuthorityBlock lang="es" />
    <FinalCTA lang="es" />
  </main>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import AuthorityBlock from "../components/AuthorityBlock.astro";
import FinalCTA from "../components/FinalCTA.astro";

const pillars = [
  {
    title: "Dynamic Revenue Marketing",
    body: "Professional listing management and data-driven pricing across every major booking platform, tuned weekly to real Puerto Vallarta demand — not a flat calendar left on autopilot.",
  },
  {
    title: "Impeccable Maintenance",
    body: "Preventive inspections, vetted contractors, and rapid response for repairs, so your property is guest-ready year-round without you fielding a single call.",
  },
  {
    title: "Luxury Guest Concierge",
    body: "White-glove check-ins, curated local recommendations, and 24/7 guest support that protect your reviews and turn first-time guests into repeat bookings.",
  },
];
---

<Layout
  title="Services | Praben Property Management"
  description="A single, all-in-one property management service for Puerto Vallarta investors — marketing, maintenance, and guest concierge, with no fragmented contracts."
>
  <main>
    <section class="bg-primary px-4 py-16 text-center sm:px-6 sm:py-24">
      <div class="mx-auto max-w-2xl">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-accent">
          Our Services
        </p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
          One Partner. Every Discipline Your Property Needs.
        </h1>
        <p class="mt-4 font-light text-white/85">
          No pointing fingers between a marketing agency, a maintenance crew,
          and a hosting platform. Praben runs all three under one
          accountable roof.
        </p>
      </div>
    </section>

    <section class="px-4 py-16 sm:px-6 sm:py-24">
      <div class="mx-auto grid max-w-6xl gap-8 md:grid-cols-3">
        {pillars.map((pillar) => (
          <div class="rounded-2xl bg-muted p-8">
            <h2 class="text-lg font-semibold text-primary">{pillar.title}</h2>
            <p class="mt-3 font-light text-muted-foreground">{pillar.body}</p>
          </div>
        ))}
      </div>
    </section>

    <AuthorityBlock />
    <FinalCTA />
  </main>
</Layout>

---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { SITE } from "../../lib/site";

const posts = (await getCollection("blogEn")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<Layout
  title="Insights | Praben Property Management"
  description="Investor insights on Puerto Vallarta short-term rentals, property management, and maximizing rental ROI."
>
  <main>
    <section class="bg-primary px-4 py-16 text-center sm:px-6 sm:py-24">
      <div class="mx-auto max-w-2xl">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-accent">
          Insights
        </p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
          Investor Insights for Puerto Vallarta.
        </h1>
        <p class="mt-4 font-light text-white/85">
          Market data, ROI guides, and ownership tips for US and Canadian
          investors.
        </p>
      </div>
    </section>

    <section class="px-4 py-16 sm:px-6 sm:py-20">
      {posts.length > 0 ? (
        <div class="mx-auto grid max-w-6xl gap-8 md:grid-cols-3">
          {posts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="block overflow-hidden rounded-2xl bg-muted shadow-sm transition hover:shadow-md"
            >
              <img
                src={post.data.heroImage}
                alt={post.data.heroImageAlt}
                class="h-48 w-full object-cover"
              />
              <div class="p-6">
                <h2 class="font-semibold text-foreground">{post.data.title}</h2>
                <p class="mt-2 font-light text-muted-foreground">{post.data.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="mx-auto max-w-xl text-center font-light text-muted-foreground">
          We're building our library of investor resources. In the meantime,
          reach out directly at{" "}
          <a href={`mailto:${SITE.email}`} class="font-medium text-primary underline">
            {SITE.email}
          </a>
          {" "}with any questions.
        </p>
      )}
    </section>
  </main>
</Layout>

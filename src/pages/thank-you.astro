---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, whatsappUrl } from "../lib/site";

// Populate this once there's guide/resource content to point new leads to.
// Cards render automatically the moment this array is non-empty.
const relatedArticles: { title: string; excerpt: string; href: string }[] = [];
---

<Layout
  title="Thank You | Praben Property Management"
  description="Your rental projection request has been received."
  noindex={true}
>
  <Header />
  <main>
    <section class="bg-primary px-4 py-20 text-center sm:px-6 sm:py-28">
      <div class="mx-auto max-w-2xl">
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="mx-auto h-14 w-14 fill-accent"
        >
          <path
            fill-rule="evenodd"
            d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm4.7 8.2a1 1 0 0 0-1.4-1.4l-4.8 4.79-1.8-1.8a1 1 0 0 0-1.4 1.42l2.5 2.5a1 1 0 0 0 1.4 0l5.5-5.5Z"
            clip-rule="evenodd"
          ></path>
        </svg>
        <h1 class="mt-6 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
          Thank You. Your Request Has Been Received.
        </h1>
        <p class="mt-4 font-light text-white/85">
          A member of our team will follow up within one business day with
          your custom rental income projection. In the meantime, feel free to
          reach us directly.
        </p>
        <a
          href={whatsappUrl()}
          target="_blank"
          rel="noopener"
          class="mt-8 inline-block rounded-lg bg-accent px-8 py-3.5 text-base font-medium text-foreground transition hover:opacity-90"
        >
          Message Us on WhatsApp
        </a>
      </div>
    </section>

    <section class="bg-muted px-4 py-16 sm:px-6 sm:py-20">
      <div class="mx-auto max-w-6xl">
        <h2 class="text-center text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
          While You Wait
        </h2>

        {relatedArticles.length > 0 ? (
          <div class="mt-10 grid gap-8 md:grid-cols-3">
            {relatedArticles.map((article) => (
              <a
                href={article.href}
                class="block rounded-2xl bg-white p-6 shadow-sm transition hover:shadow-md"
              >
                <h3 class="font-medium text-foreground">{article.title}</h3>
                <p class="mt-2 font-light text-muted-foreground">{article.excerpt}</p>
              </a>
            ))}
          </div>
        ) : (
          <p class="mx-auto mt-6 max-w-xl text-center font-light text-muted-foreground">
            We're putting together our library of investor resources. In the
            meantime, revisit
            {" "}
            <a href="/#pain-and-solution" class="font-medium text-primary underline">
              how Praben protects your investment
            </a>
            {" "}or email us directly at{" "}
            <a href={`mailto:${SITE.email}`} class="font-medium text-primary underline">
              {SITE.email}
            </a>
            .
          </p>
        )}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

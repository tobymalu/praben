---
import { SITE } from "../lib/site";

// Filled in only once real profiles exist — see SITE.social.
const sameAs = Object.values(SITE.social).filter((url) => url.length > 0);

const schema = {
  "@context": "https://schema.org",
  "@type": ["RealEstateAgent", "LocalBusiness"],
  name: SITE.name,
  image: new URL("/praben-logotipo-03.png", SITE.url).toString(),
  url: `${SITE.url}/`,
  // "+521..." per the SEO audit's explicit spec — note this differs from
  // SITE.phone.e164 ("+52...", no "1"), used for the site's own tel: links.
  // Mexican WhatsApp/schema tooling often still expects the legacy "1"
  // mobile prefix even though it's no longer required for direct dialing.
  telephone: "+5213221941849",
  email: SITE.email,
  priceRange: "$$$",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Puerto Vallarta",
    addressRegion: "Jalisco",
    addressCountry: "MX",
  },
  areaServed: [
    "Puerto Vallarta",
    "Marina Vallarta",
    "Zona Romántica",
    "Nuevo Vallarta",
    "Conchas Chinas",
    "Amapas",
  ],
  ...(sameAs.length > 0 ? { sameAs } : {}),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

---
import type { Lang } from "../lib/i18n";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    heading: "Engineered for 5-Star Experiences and Maximum ROI.",
    bullets: [
      {
        title: "Immaculate Property Care",
        body: "Regular inspections and preventive maintenance by vetted professionals.",
      },
      {
        title: "Dynamic Market Positioning",
        body: "Optimized pricing and visibility across top booking platforms to ensure high occupancy year-round.",
      },
      {
        title: "Luxury Guest Concierge",
        body: "Building guest loyalty that translates into continuous 5-star reviews.",
      },
      {
        title: "Transparent Contract",
        body: "No hidden fees. No convoluted commission tiers. Just straightforward, profitable partnership.",
      },
    ],
  },
  es: {
    heading: "Diseñado para Experiencias 5 Estrellas y Máximo Retorno.",
    bullets: [
      {
        title: "Cuidado Impecable de la Propiedad",
        body: "Inspecciones regulares y mantenimiento preventivo a cargo de profesionales verificados.",
      },
      {
        title: "Posicionamiento Dinámico en el Mercado",
        body: "Precios y visibilidad optimizados en las principales plataformas de reserva, para asegurar alta ocupación todo el año.",
      },
      {
        title: "Concierge de Huéspedes de Lujo",
        body: "Construimos la lealtad de los huéspedes que se traduce en reseñas de 5 estrellas constantes.",
      },
      {
        title: "Contrato Transparente",
        body: "Sin tarifas ocultas. Sin niveles de comisión confusos. Solo una sociedad directa y rentable.",
      },
    ],
  },
}[lang];
---

<section id="authority" class="bg-secondary px-4 py-16 sm:px-6 sm:py-24">
  <div class="mx-auto max-w-4xl">
    <h2 class="text-center text-3xl font-semibold tracking-tight text-white sm:text-4xl">
      {copy.heading}
    </h2>

    <ul class="mt-12 grid gap-x-10 gap-y-8 sm:grid-cols-2">
      {copy.bullets.map((bullet) => (
        <li class="flex gap-4">
          <svg
            aria-hidden="true"
            viewBox="0 0 20 20"
            class="mt-1 h-5 w-5 shrink-0 fill-accent"
          >
            <path
              fill-rule="evenodd"
              d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.8 3.79 6.8-6.79a1 1 0 0 1 1.4 0Z"
              clip-rule="evenodd"
            ></path>
          </svg>
          <div>
            <h3 class="font-medium text-white">{bullet.title}</h3>
            <p class="mt-1 font-light text-white/70">{bullet.body}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

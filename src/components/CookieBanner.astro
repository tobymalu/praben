---
---

<div
  id="cookie-banner"
  class="fixed inset-x-0 bottom-0 z-50 hidden border-t border-brand-gray-50 bg-background px-4 py-4 shadow-[0_-4px_16px_rgba(0,0,0,0.08)] sm:px-6"
>
  <div class="mx-auto flex max-w-6xl flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-muted-foreground">
      We use cookies to analyze traffic and improve your experience. Read our
      privacy policy to learn more.
    </p>
    <div class="flex shrink-0 gap-3">
      <button
        id="cookie-reject"
        type="button"
        class="rounded-lg border border-primary px-5 py-2 text-sm font-medium text-primary transition hover:bg-muted"
      >
        Reject
      </button>
      <button
        id="cookie-accept"
        type="button"
        class="rounded-lg bg-accent px-5 py-2 text-sm font-medium text-foreground transition hover:opacity-90"
      >
        Accept
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var CONSENT_KEY = "cookie_consent";
    var banner = document.getElementById("cookie-banner");
    if (!banner) return;

    var existing = null;
    try {
      existing = localStorage.getItem(CONSENT_KEY);
    } catch (e) {}

    if (!existing) {
      banner.classList.remove("hidden");
    }

    function updateConsent(choice) {
      try {
        localStorage.setItem(CONSENT_KEY, choice);
      } catch (e) {}

      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      var granted = choice === "granted";
      gtag("consent", "update", {
        ad_storage: granted ? "granted" : "denied",
        analytics_storage: granted ? "granted" : "denied",
        ad_user_data: granted ? "granted" : "denied",
        ad_personalization: granted ? "granted" : "denied",
      });
      dataLayer.push({
        event: granted ? "cookie_consent_granted" : "cookie_consent_denied",
      });

      banner.classList.add("hidden");
    }

    document
      .getElementById("cookie-accept")
      .addEventListener("click", function () {
        updateConsent("granted");
      });
    document
      .getElementById("cookie-reject")
      .addEventListener("click", function () {
        updateConsent("denied");
      });
  })();
</script>

---
import { SITE } from "../lib/site";
import type { Lang } from "../lib/i18n";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    eyebrow: "Puerto Vallarta Property Management",
    headline: "Maximize Your Vallarta Investment. Zero Headaches.",
    subhead:
      "Praben handles marketing, maintenance, and guest concierge for your Puerto Vallarta property — so you collect the returns without managing a thing from abroad.",
    formTitle: "Get Your Free Rental Projection",
    formSubtitle: "No commitment. A response within one business day.",
    nameLabel: "Full name",
    emailLabel: "Email",
    whatsappLabel: "WhatsApp number",
    airbnbLabel: "Airbnb listing link",
    optional: "(optional)",
    submit: "Get My Free Projection",
    errorStatus: "We couldn't submit the form — opening WhatsApp instead.",
    whatsappIntro: "Hi, I'd like a free rental income projection.",
    whatsappFields: { name: "Name", email: "Email", whatsapp: "WhatsApp", airbnb: "Airbnb" },
    thankYouPath: "/thank-you",
  },
  es: {
    eyebrow: "Administración de Propiedades en Puerto Vallarta",
    headline: "Maximiza tu Inversión en Vallarta. Cero Complicaciones.",
    subhead:
      "Praben se encarga del marketing, mantenimiento y concierge de huéspedes de tu propiedad en Puerto Vallarta — para que recibas los ingresos sin administrar nada a distancia.",
    formTitle: "Obtén tu Proyección de Renta Gratuita",
    formSubtitle: "Sin compromiso. Respuesta en menos de un día hábil.",
    nameLabel: "Nombre completo",
    emailLabel: "Correo electrónico",
    whatsappLabel: "Número de WhatsApp",
    airbnbLabel: "Enlace de tu anuncio en Airbnb",
    optional: "(opcional)",
    submit: "Obtener mi Proyección Gratuita",
    errorStatus: "No pudimos enviar el formulario — abriendo WhatsApp en su lugar.",
    whatsappIntro: "Hola, me gustaría una proyección gratuita de ingresos por renta.",
    whatsappFields: { name: "Nombre", email: "Correo", whatsapp: "WhatsApp", airbnb: "Airbnb" },
    thankYouPath: "/es/thank-you",
  },
}[lang];
---

<section id="lead-form" class="relative overflow-hidden bg-primary">
  <!-- Geometric echo of the logo mark -->
  <img
    src="/praben-ic-01.png"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute -right-16 -top-16 h-72 w-72 rotate-12 opacity-10 brightness-0 invert md:h-112 md:w-md"
  />
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-32 left-1/3 h-72 w-72 rounded-full bg-accent/10"
  >
  </div>

  <div class="relative mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 md:grid-cols-2 md:items-center md:py-24">
    <!-- Left: headline -->
    <div class="relative z-10 text-white">
      <p class="mb-4 text-sm font-medium uppercase tracking-[0.2em] text-accent">
        {copy.eyebrow}
      </p>
      <h1 class="text-4xl font-semibold leading-tight tracking-tight sm:text-5xl">
        {copy.headline}
      </h1>
      <p class="mt-6 max-w-md text-lg font-extralight text-white/85">
        {copy.subhead}
      </p>
    </div>

    <!-- Right: floating lead form -->
    <div class="relative z-10 rounded-2xl bg-white p-6 shadow-2xl sm:p-8">
      <h2 class="text-xl font-semibold text-foreground">{copy.formTitle}</h2>
      <p class="mt-1 text-sm font-light text-muted-foreground">{copy.formSubtitle}</p>

      <form id="lead-capture-form" class="mt-6 space-y-4">
        <div>
          <label for="lead-name" class="mb-1 block text-sm font-medium text-foreground">
            {copy.nameLabel}
          </label>
          <input
            id="lead-name"
            name="name"
            type="text"
            required
            autocomplete="name"
            class="w-full rounded-lg border border-brand-gray-50 bg-white px-4 py-3 text-foreground outline-none ring-primary/30 transition focus:ring-2"
          />
        </div>

        <div>
          <label for="lead-email" class="mb-1 block text-sm font-medium text-foreground">
            {copy.emailLabel}
          </label>
          <input
            id="lead-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="w-full rounded-lg border border-brand-gray-50 bg-white px-4 py-3 text-foreground outline-none ring-primary/30 transition focus:ring-2"
          />
        </div>

        <div>
          <label for="lead-whatsapp" class="mb-1 block text-sm font-medium text-foreground">
            {copy.whatsappLabel}
          </label>
          <input
            id="lead-whatsapp"
            name="whatsapp"
            type="tel"
            required
            autocomplete="tel"
            placeholder="+1 555 123 4567"
            class="w-full rounded-lg border border-brand-gray-50 bg-white px-4 py-3 text-foreground outline-none ring-primary/30 transition focus:ring-2"
          />
        </div>

        <div>
          <label for="lead-airbnb" class="mb-1 block text-sm font-medium text-foreground">
            {copy.airbnbLabel} <span class="font-extralight text-muted-foreground">{copy.optional}</span>
          </label>
          <input
            id="lead-airbnb"
            name="airbnb"
            type="url"
            placeholder="https://airbnb.com/rooms/..."
            class="w-full rounded-lg border border-brand-gray-50 bg-white px-4 py-3 text-foreground outline-none ring-primary/30 transition focus:ring-2"
          />
        </div>

        <button
          type="submit"
          class="w-full rounded-lg bg-accent px-6 py-3.5 text-base font-medium text-foreground transition hover:opacity-90"
        >
          {copy.submit}
        </button>

        <p
          id="lead-form-status"
          class="hidden text-sm font-medium"
          role="status"
          aria-live="polite"
        >
        </p>
      </form>
    </div>
  </div>
</section>

<script
  is:inline
  define:vars={{
    whatsappNumber: SITE.whatsapp.number,
    thankYouPath: copy.thankYouPath,
    errorStatus: copy.errorStatus,
    whatsappIntro: copy.whatsappIntro,
    whatsappFields: copy.whatsappFields,
  }}
>
  (function () {
    var form = document.getElementById("lead-capture-form");
    var status = document.getElementById("lead-form-status");
    if (!form || !status) return;

    // Manage this form (and where its notification emails go) at
    // https://formspree.io/forms
    var FORMSPREE_ENDPOINT = "https://formspree.io/f/mdekoyll";

    form.addEventListener("submit", async function (event) {
      event.preventDefault();
      var data = new FormData(form);

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: "generate_lead", lead_source: "hero_form" });

      try {
        var response = await fetch(FORMSPREE_ENDPOINT, {
          method: "POST",
          body: data,
          headers: { Accept: "application/json" },
        });
        if (!response.ok) throw new Error("Formspree responded with an error");
        window.location.href = thankYouPath;
      } catch (err) {
        // Never lose the lead: hand it off to WhatsApp if the form post fails.
        var message =
          whatsappIntro + "\n" +
          whatsappFields.name + ": " + data.get("name") + "\n" +
          whatsappFields.email + ": " + data.get("email") + "\n" +
          whatsappFields.whatsapp + ": " + data.get("whatsapp") +
          (data.get("airbnb") ? "\n" + whatsappFields.airbnb + ": " + data.get("airbnb") : "");

        window.open(
          "https://wa.me/" + whatsappNumber + "?text=" + encodeURIComponent(message),
          "_blank"
        );
        status.textContent = errorStatus;
        status.classList.remove("hidden");
      }
    });
  })();
</script>

---
import { SITE } from "../lib/site";
---

<section id="lead-form" class="relative overflow-hidden bg-primary">
  <!-- Geometric echo of the logo mark -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-24 -top-24 h-96 w-96 rotate-12 rounded-[3rem] bg-secondary/40 md:h-[32rem] md:w-[32rem]"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-32 left-1/3 h-72 w-72 rounded-full bg-accent/10"
  >
  </div>

  <div class="relative mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 md:grid-cols-2 md:items-center md:py-24">
    <!-- Left: headline -->
    <div class="relative z-10 text-white">
      <p class="mb-4 text-sm font-medium uppercase tracking-[0.2em] text-accent">
        Puerto Vallarta Property Management
      </p>
      <h1 class="text-4xl font-semibold leading-tight tracking-tight sm:text-5xl">
        Maximize Your Vallarta Investment. Zero Headaches.
      </h1>
      <p class="mt-6 max-w-md text-lg font-extralight text-white/85">
        Praben handles marketing, maintenance, and guest concierge for your
        Puerto Vallarta property — so you collect the returns without
        managing a thing from abroad.
      </p>
    </div>

    <!-- Right: floating lead form -->
    <div class="relative z-10 rounded-2xl bg-white p-6 shadow-2xl sm:p-8">
      <h2 class="text-xl font-semibold text-foreground">Get Your Free Rental Projection</h2>
      <p class="mt-1 text-sm font-light text-muted-foreground">
        No commitment. A response within one business day.
      </p>

      <form id="lead-capture-form" class="mt-6 space-y-4">
        <div>
          <label for="lead-name" class="mb-1 block text-sm font-medium text-foreground">
            Full name
          </label>
          <input
            id="lead-name"
            name="name"
            type="text"
            required
            autocomplete="name"
            class="w-full rounded-lg border border-brand-gray-50 bg-white px-4 py-3 text-foreground outline-none ring-primary/30 transition focus:ring-2"
          />
        </div>

        <div>
          <label for="lead-email" class="mb-1 block text-sm font-medium text-foreground">
            Email
          </label>
          <input
            id="lead-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="w-full rounded-lg border border-brand-gray-50 bg-white px-4 py-3 text-foreground outline-none ring-primary/30 transition focus:ring-2"
          />
        </div>

        <div>
          <label for="lead-whatsapp" class="mb-1 block text-sm font-medium text-foreground">
            WhatsApp number
          </label>
          <input
            id="lead-whatsapp"
            name="whatsapp"
            type="tel"
            required
            autocomplete="tel"
            placeholder="+1 555 123 4567"
            class="w-full rounded-lg border border-brand-gray-50 bg-white px-4 py-3 text-foreground outline-none ring-primary/30 transition focus:ring-2"
          />
        </div>

        <div>
          <label for="lead-airbnb" class="mb-1 block text-sm font-medium text-foreground">
            Airbnb listing link <span class="font-extralight text-muted-foreground">(optional)</span>
          </label>
          <input
            id="lead-airbnb"
            name="airbnb"
            type="url"
            placeholder="https://airbnb.com/rooms/..."
            class="w-full rounded-lg border border-brand-gray-50 bg-white px-4 py-3 text-foreground outline-none ring-primary/30 transition focus:ring-2"
          />
        </div>

        <button
          type="submit"
          class="w-full rounded-lg bg-accent px-6 py-3.5 text-base font-medium text-foreground transition hover:opacity-90"
        >
          Get My Free Projection
        </button>

        <p
          id="lead-form-status"
          class="hidden text-sm font-medium"
          role="status"
          aria-live="polite"
        >
        </p>
      </form>
    </div>
  </div>
</section>

<script define:vars={{ whatsappNumber: SITE.whatsapp.number }}>
  (function () {
    var form = document.getElementById("lead-capture-form");
    var status = document.getElementById("lead-form-status");
    if (!form || !status) return;

    // TODO: once a CRM/backend exists, set PUBLIC_LEADS_ENDPOINT and this
    // will POST there instead of falling back to a WhatsApp handoff.
    var endpoint = "";

    form.addEventListener("submit", async function (event) {
      event.preventDefault();
      var data = new FormData(form);
      var name = data.get("name");
      var email = data.get("email");
      var whatsapp = data.get("whatsapp");
      var airbnb = data.get("airbnb");

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: "generate_lead", lead_source: "hero_form" });

      if (endpoint) {
        try {
          await fetch(endpoint, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ name, email, whatsapp, airbnb }),
          });
          status.textContent = "Thank you! We'll be in touch within one business day.";
          status.classList.remove("hidden");
          form.reset();
        } catch (err) {
          status.textContent = "Something went wrong. Please try again.";
          status.classList.remove("hidden");
        }
        return;
      }

      var message =
        "Hi, I'd like a free rental income projection.\n" +
        "Name: " + name + "\n" +
        "Email: " + email + "\n" +
        "WhatsApp: " + whatsapp +
        (airbnb ? "\nAirbnb: " + airbnb : "");

      window.open(
        "https://wa.me/" + whatsappNumber + "?text=" + encodeURIComponent(message),
        "_blank"
      );
      status.textContent = "Opening WhatsApp to complete your request...";
      status.classList.remove("hidden");
    });
  })();
</script>

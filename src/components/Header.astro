---
import { SITE } from "../lib/site";
---

<header class="sticky top-0 z-40 border-b border-brand-gray-50 bg-background/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6">
    <a href="/" class="shrink-0">
      <img src="/praben-logotipo-03.png" alt={SITE.name} class="h-8 w-auto sm:h-9" />
    </a>
    <a
      href="#lead-form"
      class="rounded-lg bg-accent px-5 py-2.5 text-sm font-medium text-foreground transition hover:opacity-90"
    >
      Free Projection
    </a>
  </div>
</header>

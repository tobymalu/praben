---
import { SITE, whatsappUrl } from "../lib/site";
import type { Lang } from "../lib/i18n";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const year = new Date().getFullYear();

const copy = {
  en: {
    tagline: "Property management for Puerto Vallarta investors.",
    allies: "Our Commercial Allies",
    rights: "All rights reserved.",
  },
  es: {
    tagline: "Administración de propiedades para inversionistas en Puerto Vallarta.",
    allies: "Nuestros Aliados Comerciales",
    rights: "Todos los derechos reservados.",
  },
}[lang];
---

<footer class="bg-foreground px-4 py-10 text-white sm:px-6">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 text-center sm:flex-row sm:text-left">
    <div>
      <p class="text-lg font-semibold">{SITE.name}</p>
      <p class="mt-1 text-sm font-light text-white/70">{copy.tagline}</p>
    </div>
    <div class="flex flex-col items-center gap-1 text-sm font-light text-white/70 sm:items-end">
      <a href={`mailto:${SITE.email}`} class="hover:text-accent">{SITE.email}</a>
      <a href={whatsappUrl(undefined, lang)} class="hover:text-accent" target="_blank" rel="noopener">
        {SITE.phone.display}
      </a>
    </div>
  </div>

  <div class="mx-auto mt-8 max-w-6xl border-t border-white/10 pt-6 text-center">
    <p class="text-xs font-medium uppercase tracking-[0.2em] text-white/50">
      {copy.allies}
    </p>
    <a
      href="https://www.vallartamagico.com"
      target="_blank"
      rel="noopener"
      class="mt-2 inline-block text-sm font-light text-white/70 hover:text-accent"
    >
      Vallarta Mágico
    </a>
    <p class="mt-4 text-sm font-light text-white/70">
      &copy; {year} {SITE.name}. {copy.rights}
    </p>
  </div>
</footer>
